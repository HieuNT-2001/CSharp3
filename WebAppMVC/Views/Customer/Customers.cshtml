@using WebAppMVC.Models.Entities
@model List<Customer>

@{
    ViewData["Title"] = "Customer List";
    // var customer = Model[0];
    var customer1 = ViewData["customer1"] as Customer;
}

<table>
    <br>
    <img src="@Model[0].Image">
    <tr>
        <td>CustomerId: </td>
        <td>@Model[0].CustomerId</td>
    </tr>
    <tr>
        <td>Name: </td>
        <td>@Model[0].Name</td>
    </tr>
    <tr>
        <td>Address: </td>
        <td>@Model[0].Address</td>
    </tr>
</table>

<hr />

<p>View data customer 1</p>
<p>@(customer1 == null ? "No customer" : customer1.CustomerId.ToString())</p>
<p>@(customer1 == null ? "" : customer1.Name)</p>
<p>@(customer1 == null ? "" : customer1.Address)</p>

<hr />

<p>View data message</p>
<p>@ViewData["message"]</p>

<hr />
<p>Viewbag customer 2</p>
<p>@ViewBag.customer2.CustomerId</p>
<p>@ViewBag.customer2.Name</p>
<p>@ViewBag.customer2.Address</p>


@section Fpoly {
    <p>Section is declared at layout pages but content of</p>
}
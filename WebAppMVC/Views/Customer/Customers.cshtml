@{
    ViewData["Title"] = "Customer List";
    var customer = ViewData["customer1"] as Customer;
}

<table>
    <br>
    <img src="@Model._customers[0].Image">
    <tr>
        <td>CustomerId: </td>
        <td>@Model._customers[0].CustomerId</td>
    </tr>
    <tr>
        <td>Name: </td>
        <td>@Model._customers[0].Name</td>
    </tr>
    <tr>
        <td>Address: </td>
        <td>@Model._customers[0].Address</td>
    </tr>
</table>

<hr />

<p>View data customer 1</p>
<p>@(customer == null ? "No customer" : customer.CustomerId.ToString())</p>
<p>@(customer == null ? "" : customer.Name)</p>
<p>@(customer == null ? "" : customer.Address)</p>

<hr />

<p>View data message</p>
<p>@ViewData["message"]</p>

<hr />
<p>Viewbag customer 2</p>
<p>@ViewBag.customer2.CustomerId</p>
<p>@ViewBag.customer2.Name</p>
<p>@ViewBag.customer2.Address</p>


@section Fpoly {
    <p>Section is declared at layout pages but content of</p>
}
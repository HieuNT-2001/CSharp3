        <td>CustomerId: </td>
        <td>@Model.customerId</td>
    </tr>
    <tr>
        <td>Name: </td>
        <td>@Model.name</td>
    </tr>
    <tr>
        <td>Address: </td>
        <td>@Model.address</td>
    </tr>
</table>
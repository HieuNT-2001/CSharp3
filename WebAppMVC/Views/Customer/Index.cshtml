@using WebAppMVC.Models.Entities
@* Khai báo kiểu dữ liệu (model) mà View này sẽ sử dụng. *@
@* @model: Razor directive dùng để xác định kiểu dữ liệu được truyền từ Controller vào View. *@
@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<p>
    <a asp-controller="Customer" asp-action="Create" class="btn btn-primary">Create New</a>
    <a asp-controller="Customer" asp-action="Customers" class="btn btn-primary">Customer Test</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CustomerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Image)
                </td>
                <td>
                    <a asp-controller="Customer" asp-action="Edit" asp-route-id="@item.CustomerId"
                       class="btn btn-warning">Edit</a> |
                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@item.CustomerId"
                       class="btn btn-secondary">Details</a> |
                    <a asp-controller="Customer" asp-action="Delete" asp-route-id="@item.CustomerId"
                       class="btn btn-danger">Delete</a>
                    @* @Html.ActionLink("Edit", "Edit", new { id = item.CustomerId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.CustomerId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.CustomerId }) *@
                </td>
            </tr>
        }
    </tbody>
</table>
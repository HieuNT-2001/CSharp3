@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <p>Get Cookies: <a asp-area="" asp-controller="Home" asp-action="GetCookie">Get Cookie</a></p>
    <p>Delete Cookies: <a asp-area="" asp-controller="Home" asp-action="DeleteCookie">Delete Cookie</a></p>
    <p>Get Complex Data: <a asp-area="" asp-controller="Home" asp-action="GetComplexData">ComplexDataSession</a></p>
    <b>UserId: </b> @HttpContextAccessor?.HttpContext?.Request.Cookies["UserId"] <br />
    <b>Username: </b> @HttpContextAccessor?.HttpContext?.Request.Cookies["UserName"] <br />
</div>
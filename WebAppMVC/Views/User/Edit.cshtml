@model EditRoleViewModel

@{
    ViewData["Title"] = "Set Role for User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Edit Roles for @Model.Email</h3>

<form method="post">
    <input type="hidden" asp-for="UserId" />


    <div class="card mb-3">
        <div class="card-header">User Roles</div>
        <div class="card-body">
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div>
                    <input type="checkbox" asp-for="Roles[i].IsSelected" />
                    <label>@Model.Roles[i].RoleName</label>
                    <input type="hidden" asp-for="Roles[i].RoleName" />
                </div>
            }
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

